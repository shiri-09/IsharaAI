# Which LLM answers first; the other is the automatic fallback: gemini | ollama
LLM_PRIMARY=gemini

# Gemini (Google AI Studio key). Model name is configurable; check the current model list in AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local LLM via Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=hf.co/unsloth/Qwen3.5-9B-GGUF:Q4_K_M
# Sends "think": false so Qwen-style thinking models reply in ~1s. Set to false for models that reject it.
OLLAMA_SEND_THINK=true
# Send the signer's webcam filmstrip to Ollama (the default Qwen3.5 GGUF supports vision)
OLLAMA_VISION=true

# Auth provider: supabase (Supabase Auth) | local (built-in, offline fallback)
AUTH_PROVIDER=local
# From Supabase dashboard -> Project Settings -> API (URL + anon/publishable key; both are public)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional: keep users/history in Supabase Postgres instead of local SQLite, e.g.
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Local auth only: change this to a long random string
JWT_SECRET=change-me

# Minimum softmax confidence for a recognised sentence to be auto-sent
MIN_CONFIDENCE=0.5
