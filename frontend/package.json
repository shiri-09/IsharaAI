{
  "name": "ishara-ai-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "postinstall": "node -e \"const fs=require('fs');fs.cpSync('node_modules/@mediapipe/tasks-vision/wasm','public/mediapipe/wasm',{recursive:true});fs.mkdirSync('public/ort',{recursive:true});for(const f of ['ort-wasm-simd-threaded.wasm','ort-wasm-simd-threaded.mjs'])fs.copyFileSync('node_modules/onnxruntime-web/dist/'+f,'public/ort/'+f)\""
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.3",
    "@supabase/supabase-js": "^2.119.0",
    "lucide-react": "^1.72.0",
    "onnxruntime-web": "^1.20.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}